---
source: crates/query/src/sql_tests.rs
expression: "render(&sql, &params)"
---
SELECT d0, d1, sum(c_visitors) AS m0, sum(c_visits) AS m1, ifNotFinite(sum(c_b_bounces) / sum(c_b_n), 0) AS m2
FROM (
  SELECT toString(subtractDays(toDate(toTimeZone(ts, {tz:String})), modulo(toDayOfWeek(toDate(toTimeZone(ts, {tz:String}))) - {wk:UInt8} + 7, 7))) AS d0, toString(device) AS d1, uniq(visitor_id) AS c_visitors, toUInt64(0) AS c_visits, toUInt64(0) AS c_b_n, toUInt64(0) AS c_b_bounces
  FROM (
    SELECT *
    FROM events
    WHERE site_id = {site:UInt64} AND toDate(ts) >= {from_date:Date} AND toDate(ts) <= {to_date:Date} AND ts >= fromUnixTimestamp64Milli({from_ms:Int64}, 'UTC') AND ts < fromUnixTimestamp64Milli({to_ms:Int64}, 'UTC') AND name != 'engagement') AS e
  GROUP BY d0, d1
  UNION ALL SELECT toString(subtractDays(toDate(toTimeZone(greatest(s_start, fromUnixTimestamp64Milli({from_ms:Int64}, 'UTC')), {tz:String})), modulo(toDayOfWeek(toDate(toTimeZone(greatest(s_start, fromUnixTimestamp64Milli({from_ms:Int64}, 'UTC')), {tz:String}))) - {wk:UInt8} + 7, 7))) AS d0, toString(a_device) AS d1, toUInt64(0) AS c_visitors, count() AS c_visits, count() AS c_b_n, countIf(s_pv <= 1 AND s_inter = 0) AS c_b_bounces
  FROM (
    SELECT session_id, min(started_at) AS s_start, max(last_event_at) AS s_last, sum(pageviews) AS s_pv, sum(interactive_events) AS s_inter, sum(engagement_ms) AS s_eng, any(device) AS a_device
    FROM sessions
    WHERE site_id = {site:UInt64} AND start_date >= {s_from:Date} AND start_date <= {to_date:Date}
    GROUP BY site_id, start_date, session_id
    HAVING s_last >= fromUnixTimestamp64Milli({from_ms:Int64}, 'UTC') AND s_start < fromUnixTimestamp64Milli({to_ms:Int64}, 'UTC'))
  GROUP BY d0, d1)
GROUP BY d0, d1
ORDER BY d0 ASC, m0 DESC, d1 ASC
LIMIT {p0:UInt64} OFFSET {p1:UInt64}

-- params
site: UInt64 = 4242
from_ms: Int64 = 1777586400000
to_ms: Int64 = 1792749600001
from_date: Date = "2026-04-30"
to_date: Date = "2026-10-23"
s_from: Date = "2026-04-23"
tz: String = "Europe/Berlin"
wk: UInt8 = 7
p0: UInt64 = 10000
p1: UInt64 = 0
