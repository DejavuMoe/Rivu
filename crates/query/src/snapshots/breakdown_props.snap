---
source: crates/query/src/sql_tests.rs
expression: "render(&sql, &params)"
---
SELECT d0, sum(c_visitors) AS m0, sum(c_visits) AS m1, sum(c_events) AS m2
FROM (
  SELECT toString(props[{pk0:String}]) AS d0, uniq(visitor_id) AS c_visitors, count() AS c_events, uniq(session_id) AS c_visits
  FROM (
    SELECT *
    FROM events
    WHERE site_id = {site:UInt64} AND toDate(ts) >= {from_date:Date} AND toDate(ts) <= {to_date:Date} AND ts >= fromUnixTimestamp64Milli({from_ms:Int64}, 'UTC') AND ts < fromUnixTimestamp64Milli({to_ms:Int64}, 'UTC') AND name != 'engagement' AND (NOT (props[{pk0:String}] IN {p0:Array(String)}) AND multiSearchAny(props[{pk1:String}], {p1:Array(String)}))) AS e
  GROUP BY d0)
GROUP BY d0
ORDER BY m0 DESC, d0 ASC
LIMIT {p2:UInt64} OFFSET {p3:UInt64}

-- params
site: UInt64 = 4242
from_ms: Int64 = 1792188000000
to_ms: Int64 = 1792749600001
from_date: Date = "2026-10-16"
to_date: Date = "2026-10-23"
s_from: Date = "2026-10-09"
tz: String = "Europe/Berlin"
wk: UInt8 = 7
pk0: String = "plan"
pk1: String = "Seats Count"
p0: Array(String) = [""]
p1: Array(String) = ["1"]
p2: UInt64 = 10
p3: UInt64 = 0
