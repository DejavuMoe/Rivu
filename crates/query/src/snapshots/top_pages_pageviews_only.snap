---
source: crates/query/src/sql_tests.rs
expression: "render(&sql, &params)"
---
SELECT d0, sum(c_visitors) AS m0, sum(c_visits) AS m1, sum(c_pageviews) AS m2
FROM (
  SELECT toString(pathname) AS d0, uniq(visitor_id) AS c_visitors, countIf(name = 'pageview') AS c_pageviews, uniq(session_id) AS c_visits
  FROM (
    SELECT *
    FROM events
    WHERE site_id = {site:UInt64} AND toDate(ts) >= {from_date:Date} AND toDate(ts) <= {to_date:Date} AND ts >= fromUnixTimestamp64Milli({from_ms:Int64}, 'UTC') AND ts < fromUnixTimestamp64Milli({to_ms:Int64}, 'UTC') AND name != 'engagement' AND name IN {p0:Array(String)}) AS e
  GROUP BY d0)
GROUP BY d0
ORDER BY m0 DESC, m1 DESC, m2 DESC, d0 ASC
LIMIT {p1:UInt64} OFFSET {p2:UInt64}

-- params
site: UInt64 = 4242
from_ms: Int64 = 1790200800000
to_ms: Int64 = 1792749600001
from_date: Date = "2026-09-23"
to_date: Date = "2026-10-23"
s_from: Date = "2026-09-16"
tz: String = "Europe/Berlin"
wk: UInt8 = 7
p0: Array(String) = ["pageview"]
p1: UInt64 = 10
p2: UInt64 = 0
