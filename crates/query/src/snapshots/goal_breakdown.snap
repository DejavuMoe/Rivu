---
source: crates/query/src/sql_tests.rs
expression: "render(&sql, &params)"
---
SELECT d0, sum(c_visitors) AS m0, sum(c_events) AS m1, ifNotFinite(sum(c_visitors) / sum(c_cr_base), 0) AS m2
FROM (
  SELECT arrayJoin(arrayDistinct(arrayFilter(g_l -> g_l != '', [if((name = {p1:String}), {p2:String}, ''), if(((name = 'pageview' AND pathname LIKE {p3:String})), {p4:String}, ''), if(((name = 'pageview' AND pathname LIKE {p5:String})), {p6:String}, '')]))) AS d0, uniq(visitor_id) AS c_visitors, count() AS c_events, toUInt64(0) AS c_cr_base
  FROM (
    SELECT *
    FROM events
    WHERE site_id = {site:UInt64} AND toDate(ts) >= {from_date:Date} AND toDate(ts) <= {to_date:Date} AND ts >= fromUnixTimestamp64Milli({from_ms:Int64}, 'UTC') AND ts < fromUnixTimestamp64Milli({to_ms:Int64}, 'UTC') AND name != 'engagement' AND toString(country_code) IN {p0:Array(String)}) AS e
  GROUP BY d0
  UNION ALL SELECT arrayJoin({p8:Array(String)}) AS d0, toUInt64(0) AS c_visitors, toUInt64(0) AS c_events, uniq(visitor_id) AS c_cr_base
  FROM (
    SELECT *
    FROM events
    WHERE site_id = {site:UInt64} AND toDate(ts) >= {from_date:Date} AND toDate(ts) <= {to_date:Date} AND ts >= fromUnixTimestamp64Milli({from_ms:Int64}, 'UTC') AND ts < fromUnixTimestamp64Milli({to_ms:Int64}, 'UTC') AND name != 'engagement' AND toString(country_code) IN {p7:Array(String)}) AS e
  GROUP BY d0)
GROUP BY d0
HAVING sum(c_visitors) > 0
ORDER BY m0 DESC, d0 ASC
LIMIT {p9:UInt64} OFFSET {p10:UInt64}

-- params
site: UInt64 = 4242
from_ms: Int64 = 1790200800000
to_ms: Int64 = 1792749600001
from_date: Date = "2026-09-23"
to_date: Date = "2026-10-23"
s_from: Date = "2026-09-16"
tz: String = "Europe/Berlin"
wk: UInt8 = 7
p0: Array(String) = ["DE"]
p1: String = "Signup"
p2: String = "Signup"
p3: String = "/checkout/%/done"
p4: String = "Checkout"
p5: String = "/a\\_b\\%c\\\\d"
p6: String = "/a_b%c\\d"
p7: Array(String) = ["DE"]
p8: Array(String) = ["/a_b%c\\d", "Checkout", "Signup"]
p9: UInt64 = 10000
p10: UInt64 = 0
