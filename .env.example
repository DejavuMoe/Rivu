# Rivu 开发环境默认值，与 deploy/compose.dev.yml 的账号和端口一致。
# 仅用于开发：这些密码是公开的，不得用于生产。
#
# rivu 程序本身不读 .env 文件，需要先把这些变量加载进 shell 环境（见 README.md）：
#   PowerShell:  Get-Content .env.example | Where-Object { $_ -match '^\s*[^#\s][^=]*=' } | ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item "env:$($k.Trim())" $v.Trim() }
#   bash:        set -a; source .env.example; set +a
# 每个变量都有 <NAME>_FILE 形式（从文件读取并去掉首尾空白）；同时设置两者会报错。
# 注意：值里不要加引号，也不要在值后面写行内注释，否则 PowerShell 的简易加载方式会把它们当成值的一部分。

# --- PostgreSQL ---
# 应用账号 rivu_app（无 DDL 权限）
RIVU_DATABASE_URL=postgres://rivu_app:rivu_dev_app@127.0.0.1:5432/rivu
# 只有 `rivu migrate` 使用：库 owner rivu_migrator（可 DDL）；不设置时 migrate 回退用 RIVU_DATABASE_URL
RIVU_MIGRATE_DATABASE_URL=postgres://rivu_migrator:rivu_dev_migrator@127.0.0.1:5432/rivu

# --- ClickHouse（HTTP 接口） ---
RIVU_CLICKHOUSE_URL=http://127.0.0.1:8123
RIVU_CH_DATABASE=rivu
RIVU_CH_MIGRATOR_USER=rivu_migrator
RIVU_CH_MIGRATOR_PASSWORD=rivu_dev_migrator
RIVU_CH_WRITER_USER=rivu_writer
RIVU_CH_WRITER_PASSWORD=rivu_dev_writer
RIVU_CH_READER_USER=rivu_reader
RIVU_CH_READER_PASSWORD=rivu_dev_reader
RIVU_CH_MAINTAINER_USER=rivu_maintainer
RIVU_CH_MAINTAINER_PASSWORD=rivu_dev_maintainer

# --- 监听地址 ---
# 公共端口：collector 的 POST /api/event、api 的 /api/*
RIVU_LISTEN_ADDR=127.0.0.1:8080
# 内部端口：/healthz /readyz /metrics，不要对外暴露
RIVU_INTERNAL_ADDR=127.0.0.1:9090

# --- 日志 ---
# json | pretty
RIVU_LOG_FORMAT=pretty
RIVU_LOG_LEVEL=info

# --- 运行模式 ---
# lite | reliable（`rivu all` 只允许 lite）
RIVU_MODE=lite
# 逗号分隔的 CIDR 列表；留空表示不信任任何代理（只有对端地址在名单内才采用 X-Forwarded-For）
RIVU_TRUSTED_PROXIES=

# --- 写缓冲与站点缓存（都有默认值，下面是默认值） ---
# flush 间隔（毫秒）、单批行数、单批字节数、有界 channel 容量（满了 POST /api/event 回 503）
# RIVU_BUFFER_FLUSH_INTERVAL_MS=1000
# RIVU_BUFFER_MAX_ROWS=20000
# RIVU_BUFFER_MAX_BYTES=8388608
# RIVU_BUFFER_CHANNEL_CAPACITY=200000
# 站点快照全量重载周期（秒）
# RIVU_SITE_CACHE_REFRESH_SECS=10

# --- 查询超时（秒，1..=300，都有默认值；须不大于 rivu_reader profile 的 max_execution_time 上限） ---
# 看板、公开 API、公开看板与共享链接各一档
# RIVU_QUERY_TIMEOUT_SECS=10
# RIVU_API_QUERY_TIMEOUT_SECS=20
# RIVU_PUBLIC_QUERY_TIMEOUT_SECS=5

# --- 数据目录与 GeoIP（system-design §4.4、platform-and-ops §7） ---
# GeoIP 库与本地导出放在这里；开发时放进 target/ 下（已被 .gitignore 忽略），生产默认 /var/lib/rivu
RIVU_DATA_DIR=./target/rivu-data
# 以下都有默认值，按需取消注释。来源优先级：RIVU_GEOIP_DB_URL > RIVU_MAXMIND_LICENSE_KEY > DB-IP Lite（默认，免配置）。
# 同时配置多个来源时只用优先级最高的，其余忽略并在启动时打 warn。
# 库文件（默认 ${RIVU_DATA_DIR}/geoip/geoip.mmdb；旁边的 .meta.json 记录来源、ETag、署名）
# RIVU_GEOIP_DB_PATH=./target/rivu-data/geoip/geoip.mmdb
# 默认来源 DB-IP Lite 的版本：city（默认，约 60 MB 压缩）| country（约 4 MB 压缩）。CC BY 4.0，看板与 API 必须署名
# RIVU_DBIP_EDITION=country
# 自定义 mmdb 直链（.mmdb 或 .mmdb.gz）；URL 可能带令牌，生产里用 RIVU_GEOIP_DB_URL_FILE，日志里一律脱敏
# RIVU_GEOIP_DB_URL=
# MaxMind GeoLite2：现行下载接口用 HTTP Basic，Account ID + License Key 两个都要
# RIVU_MAXMIND_ACCOUNT_ID=
# RIVU_MAXMIND_LICENSE_KEY=
# RIVU_MAXMIND_EDITION=GeoLite2-City
# 条件 GET 的刷新周期（带 ±10% 抖动）：下限 1h，0 表示不定期刷新、只在没有本地副本时下载一次
# RIVU_GEOIP_REFRESH_INTERVAL=24h
# 自定义来源（或手工放置的库文件）的署名；DB-IP 与 MaxMind 使用内置署名，不读这两个变量
# RIVU_GEOIP_ATTRIBUTION_TEXT=
# RIVU_GEOIP_ATTRIBUTION_URL=

# --- 仅集成测试使用（cargo test 时读取，缺失则跳过集成测试） ---
RIVU_TEST_DATABASE_URL=postgres://rivu_migrator:rivu_dev_migrator@127.0.0.1:5432/rivu
RIVU_TEST_CLICKHOUSE_URL=http://127.0.0.1:8123
