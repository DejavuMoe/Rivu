<?xml version="1.0"?>
<!--
  !!! 仅用于开发，不得用于生产 !!!
  密码是公开的开发值。生产环境请用 Docker secrets 注入（from_env）并换成强密码。

  Rivu 的四个 ClickHouse 账号（docs/architecture/platform-and-ops.md §8）：
    rivu_migrator    DDL（CREATE/ALTER/DROP/TRUNCATE）+ INSERT + SELECT，仅 `rivu migrate` 使用
    rivu_writer      INSERT，外加 schema_migrations 的 SELECT（只跑 collector 时 /readyz 用）与 sessions 的 SELECT
                     （collector 启动时从 ClickHouse 预热会话），collector / worker 使用；
                     mv_sessions 以 rivu_migrator 身份运行（SQL SECURITY DEFINER），writer 不需要 events 的 SELECT
    rivu_reader      readonly=1 的只读账号，api 使用；带配额和查询限制
    rivu_maintainer  ALTER DELETE（DELETE 与 DROP PARTITION 都由该权限控制）+ SELECT，删除批处理和 rollup 构建使用；
                     轻量删除另需 events / sessions / ingest_counters 上 _row_exists 列的 ALTER UPDATE
  default 账号：只允许本机（容器内）访问，不对宿主机端口映射开放。

  数据库名固定为 rivu（RIVU_CH_DATABASE 的默认值）；授权对象在库尚未创建时也可以先声明。
-->
<clickhouse>
    <profiles>
        <rivu_reader>
            <readonly>1</readonly>
            <max_execution_time>15</max_execution_time>
            <max_memory_usage>4294967296</max_memory_usage>
            <max_result_rows>1000000</max_result_rows>
            <result_overflow_mode>throw</result_overflow_mode>
            <!-- 正则上限：这两个默认是 0（不限制），必须显式设置（核实报告 #11）。 -->
            <max_hyperscan_regexp_length>256</max_hyperscan_regexp_length>
            <max_hyperscan_regexp_total_length>2560</max_hyperscan_regexp_total_length>
            <constraints>
                <!-- readonly=1 下默认不能改任何 setting；这两项要放开：
                     log_comment 给每条查询归因，max_execution_time 给公开链接调低超时。 -->
                <log_comment>
                    <changeable_in_readonly/>
                </log_comment>
                <max_execution_time>
                    <max>20</max>
                    <changeable_in_readonly/>
                </max_execution_time>
            </constraints>
        </rivu_reader>
    </profiles>

    <quotas>
        <rivu_reader>
            <interval>
                <duration>3600</duration>
                <queries>100000</queries>
                <errors>10000</errors>
                <execution_time>7200</execution_time>
            </interval>
        </rivu_reader>
    </quotas>

    <users>
        <default>
            <networks replace="replace">
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
        </default>

        <rivu_migrator>
            <password>rivu_dev_migrator</password>
            <networks><ip>::/0</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT CREATE, ALTER, DROP, TRUNCATE, INSERT, SELECT, SHOW ON rivu.*</query>
            </grants>
        </rivu_migrator>

        <rivu_writer>
            <password>rivu_dev_writer</password>
            <networks><ip>::/0</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT INSERT ON rivu.*</query>
                <query>GRANT SELECT ON rivu.schema_migrations</query>
                <query>GRANT SELECT ON rivu.sessions</query>
            </grants>
        </rivu_writer>

        <rivu_reader>
            <password>rivu_dev_reader</password>
            <networks><ip>::/0</ip></networks>
            <profile>rivu_reader</profile>
            <quota>rivu_reader</quota>
            <grants>
                <query>GRANT SELECT ON rivu.*</query>
            </grants>
        </rivu_reader>

        <rivu_maintainer>
            <password>rivu_dev_maintainer</password>
            <networks><ip>::/0</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT, ALTER DELETE ON rivu.*</query>
                <!-- 轻量删除（DELETE FROM … WHERE）在 25.8 上实现为改写隐藏列 _row_exists，
                     除 ALTER DELETE 外还要这一列的 ALTER UPDATE；只授予这一列、只授予 ch_delete_batch 删除的三张表。 -->
                <query>GRANT ALTER UPDATE(_row_exists) ON rivu.events</query>
                <query>GRANT ALTER UPDATE(_row_exists) ON rivu.sessions</query>
                <query>GRANT ALTER UPDATE(_row_exists) ON rivu.ingest_counters</query>
                <!-- 日汇总层：rollup_build 写入（INSERT … SELECT），时区变更与统计删除时轻量删除 -->
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_site</query>
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_pages</query>
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_entry_pages</query>
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_exit_pages</query>
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_sources</query>
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_locations</query>
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_devices</query>
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_browsers</query>
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_os</query>
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_events</query>
                <query>GRANT INSERT, ALTER DELETE, ALTER UPDATE(_row_exists) ON rivu.rollup_props</query>
                <!-- ch_monitor：parts、merge 与 mutation 积压（系统表只列出有权限的表，即 rivu 库） -->
                <query>GRANT SELECT ON system.parts</query>
                <query>GRANT SELECT ON system.merges</query>
                <query>GRANT SELECT ON system.mutations</query>
            </grants>
        </rivu_maintainer>
    </users>
</clickhouse>
