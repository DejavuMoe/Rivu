# deploy/compose.yml 的配置。复制为 deploy/.env（已在 .gitignore 中）后填写。
# 每个密码都要换成随机值，例如 `openssl rand -hex 24`；只用字母和数字，它们会出现在连接串里。

# 对外域名（不带协议）。看板、采集脚本与 API 都在这个域名下
RIVU_DOMAIN=stats.example.com

# 镜像：自己构建的 rivu:latest，或发布的 registry 地址与版本
RIVU_IMAGE=rivu:latest

# 宿主机上 rivu 公共端口的绑定（只绑 127.0.0.1，由反向代理转发）
RIVU_HTTP_PORT=8080

# 首次初始化令牌（至少 16 个字符）：打开 https://<域名>/setup 创建第一个账号时要填
RIVU_SETUP_TOKEN=

# 访客密钥（至少 32 个字符）：与每天的盐一起计算访客 ID，不进数据库。丢失只会让当天的访客 ID 断开一次
RIVU_VISITOR_PEPPER=

# PostgreSQL：migrator 是库的所有者（只用于迁移），app 是 rivu 运行时的账号
RIVU_PG_MIGRATOR_PASSWORD=
RIVU_PG_APP_PASSWORD=

# ClickHouse 的四个账号（权限见 deploy/prod/clickhouse/rivu.xml）
RIVU_CH_MIGRATOR_PASSWORD=
RIVU_CH_WRITER_PASSWORD=
RIVU_CH_READER_PASSWORD=
RIVU_CH_MAINTAINER_PASSWORD=

# 可选：compose 网络的网段（与宿主机已有网段冲突时修改）；RIVU_TRUSTED_PROXIES 只信任这个网段
# RIVU_SUBNET=172.31.250.0/24
# RIVU_LOG_LEVEL=info
# 可选：原始数据保留天数上限（默认 731，30..=36500）；站点可以在设置里调得更短，日汇总数据永久保留
# RIVU_RETENTION_DAYS=731
