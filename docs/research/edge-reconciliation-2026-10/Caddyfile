{
	admin off
	servers {
		trusted_proxies static 127.0.0.1/32
	}
}
http://127.0.0.1:18443 {
	log {
		output stdout
		format filter {
			request>remote_ip delete
			request>client_ip delete
			request>headers delete
		}
	}
	handle /api/event {
		reverse_proxy 127.0.0.1:18280 {
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}
